{
  "name": "dangerous-alone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dangerous Alone: split-screen engine for NES Zelda with other enhancements. Bring a legally obtained ROM; no Nintendo assets included.",
  "scripts": {
    "extract": "node tools/extract/cli.js",
    "test": "node tools/test/run.js",
    "test:browser": "node --test tools/browser/*.browsertest.js",
    "dev": "vite --config game/vite.config.js",
    "build": "vite build --config game/vite.config.js",
    "preview": "vite preview --config game/vite.config.js",
    "enhance": "node tools/enhance/cli.js",
    "enhance:ai": "node tools/enhance/cli.js --ai",
    "story:boards": "node tools/story/buildStoryboards.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pixi.js": "^8.9.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vite": "^6.3.5"
  }
}
