node_modules/
dist/
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs / coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.turbo/
