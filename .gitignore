# Legally sensitive / local-only game data
zelda.nes
*.nes
*.unf
*.unif
*.fds
*.nsf
*.nsfe
*.smc
*.sfc
*.sav
*.srm
*.chr

# Official Nintendo publications (keep local; never commit)
docs/context/manual.pdf

# Third-party walkthroughs (keep local; do not publish without permission)
docs/context/walkthrough.txt

# Extracted assets from the ROM (regenerated by tools)
assets/extracted/**
!assets/extracted/.gitkeep

# Editor overlays of extracted Nintendo maps (same legal status as extracted/)
assets/overrides/**
!assets/overrides/.gitkeep

# Third-party reference checkouts (disassemblies, etc.)
reference/

# Node / Vite
node_modules/
dist/
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs / coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.turbo/

# Intermediate AI tile renders (regenerable, and must stay out of publicDir)
assets/ai-cache/

# Python bytecode from enhance tooling
__pycache__/
*.pyc

# Scratch previews dumped while proving a render
tmp_*.png
